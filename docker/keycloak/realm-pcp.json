{
  "realm": "pcp",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "Pharmacy Council of Pakistan (Demo)",
  "displayNameHtml": "<b>PCP</b> Digital Portal (Demo)",
  "loginTheme": "pcp",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(8)",
  "roles": {
    "realm": [
      {
        "name": "inst_poc",
        "description": "Institution Focal Person (POC)"
      },
      {
        "name": "pcp_admin",
        "description": "PCP Super Admin: users and institutions"
      },
      {
        "name": "pcp_officer",
        "description": "PCP Officer: processes applications"
      },
      {
        "name": "pcp_inspector",
        "description": "PCP Inspector: assigned inspections only"
      },
      {
        "name": "pcp_secretary",
        "description": "PCP Secretary: council decisions and certificates"
      }
    ]
  },
  "groups": [
    {
      "name": "institutions",
      "path": "/institutions",
      "subGroups": [
        {
          "name": "PCP-UNI-000101",
          "path": "/institutions/PCP-UNI-000101"
        },
        {
          "name": "PCP-UNI-000102",
          "path": "/institutions/PCP-UNI-000102"
        },
        {
          "name": "PCP-UNI-000103",
          "path": "/institutions/PCP-UNI-000103"
        },
        {
          "name": "PCP-UNI-000104",
          "path": "/institutions/PCP-UNI-000104"
        },
        {
          "name": "PCP-UNI-000105",
